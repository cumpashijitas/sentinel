# Sentinel — configuración del backend (back/).
#
# Copia este archivo a `.env` (en esta misma carpeta) y completa los
# valores. `.env` está en .gitignore — nunca se commitea.

PORT=3000
# Orígenes permitidos para CORS (Flutter Web corre en su propio origen).
# Varios valores separados por coma. "*" en dev si no quieres pensarlo.
CORS_ORIGIN=*

# Postgres del proyecto Supabase — Project Settings → Database → Connection
# string ("Session pooler" funciona bien para esta carga; no requiere
# Docker, es una conexión normal a un Postgres remoto).
DATABASE_URL=postgresql://postgres:TU_PASSWORD@TU_PROYECTO.supabase.co:5432/postgres

# Project Settings → API → Project URL / "anon" "publishable" key. Usadas
# ÚNICAMENTE por back/src/routes/auth.routes.ts para hablar con Supabase
# Auth en nombre del front (registro/login/refresh/logout) — el front no
# tiene ninguna de estas dos credenciales (ver docs/architecture.md).
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZA_CON_TU_SUPABASE_PUBLISHABLE_KEY

# Project Settings → API → JWT Settings → "JWT Secret". El backend lo usa
# para verificar el access token que Supabase Auth le dio al front (vía
# /auth/login o /auth/register de arriba) en cada request — es la única
# participación de Supabase en autorización desde este backend en
# adelante (ver docs/architecture.md).
SUPABASE_JWT_SECRET=REEMPLAZA_CON_TU_JWT_SECRET

# --- Despacho de alertas de accidente (opcional) ---
# Sin configurar, cada canal cae a un proveedor "Noop": el pipeline corre
# igual (se registra el intento en `alerts` con status='failed' y un motivo
# claro), solo que no se envía nada de verdad. Ver back/src/alerts/.

# Firebase Cloud Messaging — JSON completo de la cuenta de servicio
# (Firebase Console → Configuración del proyecto → Cuentas de servicio →
# Generar nueva clave privada), como una sola línea.
FCM_SERVICE_ACCOUNT_JSON=

# Twilio (SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta WhatsApp Cloud API
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=accident_alert
META_WHATSAPP_TEMPLATE_LANG=es
