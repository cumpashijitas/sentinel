# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related (front/ is the Flutter project root)
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/front/build/
/front/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/front/android/app/debug
/front/android/app/profile
/front/android/app/release

# Widget Preview related
.widget_preview/

# Node.js (Supabase CLI is installed as a dev dependency via npm; also used
# by the root scripts and by back/)
node_modules/

# back/ (Node/TypeScript backend) build output
/back/dist/

# Supabase CLI local runtime state (not project config/migrations)
supabase/.branches/
supabase/.temp/

# Never commit service-role or other server-side secrets locally
.env
.env.*
!.env.example

# Claude Code local session state (not project content)
.claude/
