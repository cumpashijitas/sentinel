<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-build-only (android/app/src/debug/, same source set as
  AndroidManifest.xml's INTERNET permission fragment): allows cleartext
  (HTTP, not HTTPS) traffic to the local-dev Supabase hosts config/*.json
  can point at — 127.0.0.1/10.0.2.2 (emulator), and the LAN IP a physical
  device on the same Wi-Fi reaches this machine at
  (config/dev.lan.json). targetSdkVersion 36 blocks cleartext to any host
  by default (since API 28) unless explicitly allowed here.

  Never merged into a release build — prod (config/prod.json) always
  points at a real Supabase project over HTTPS, which needs none of this
  and must never get it.

  The LAN IP is whatever this dev machine's Wi-Fi address was when this
  file was written (see config/dev.lan.json) — update both together if it
  changes (a new network, a DHCP lease renewal).
-->
<network-security-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
    <domain includeSubdomains="false">192.168.0.20</domain>
  </domain-config>
</network-security-config>
