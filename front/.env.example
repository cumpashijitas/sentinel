# Sentinel — configuración del front (Flutter).
#
# Copia este archivo a `.env` (en esta misma carpeta, front/) y completa los
# valores. `.env` está en .gitignore — nunca se commitea.
#
# El front NO tiene ninguna credencial de ningún servicio externo — nada de
# Supabase, nada de proveedores de push/SMS/WhatsApp. Lo único que necesita
# saber es dónde vive su propio backend (back/); todas esas conexiones
# reales viven en back/.env — ver docs/architecture.md.
#
# flutter_dotenv empaqueta este archivo como asset de la app (ver
# pubspec.yaml), así que `flutter run`/`flutter build apk` funcionan sin
# flags extra: solo necesitan que este archivo exista.

# URL del backend propio (back/). En Web / dispositivo físico en la misma
# red que tu PC, usa la IP de tu máquina; en el emulador de Android usa
# 10.0.2.2 (alias reservado al host).
API_BASE_URL=http://localhost:3000

ENVIRONMENT=dev

# Mapa (OpenStreetMap vía flutter_map) — opcional, ya tiene el default de
# arriba si se deja vacío. No es una credencial de cuenta, solo la URL de
# un servidor de tiles (plantilla XYZ: {z}/{x}/{y}).
MAP_TILES_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_TILE_PROVIDER=OpenStreetMap
MAP_OFFLINE_ENABLED=false
MAP_ATTRIBUTION=© OpenStreetMap contributors
