# Sentinel V2 — dispatch-accident-alerts Edge Function secrets.
#
# Copy this file to `supabase/functions/.env` (already gitignored, same
# convention as config/*.json — see README §4) and fill in real values.
# `supabase start`/`supabase functions serve` load this file automatically
# for local development; a deployed project instead uses
# `npx supabase secrets set --env-file supabase/functions/.env`.
#
# Every value below is optional in the sense that its absence degrades
# gracefully (see providers.ts) rather than crashing the function — but
# ACCIDENT_ALERT_WEBHOOK_SECRET is required for the pipeline to run at all
# end-to-end; see docs/alerts.md for the matching Vault setup step (the
# trigger and the function must share the exact same secret value).

# Shared secret the accident_events trigger attaches as `x-webhook-secret`.
# Must exactly match the value stored in Vault under the name
# 'accident_alert_webhook_secret' — see docs/alerts.md.
ACCIDENT_ALERT_WEBHOOK_SECRET=

# Firebase service account JSON (Firebase Console → Project Settings →
# Service Accounts → Generate new private key), as a SINGLE LINE. Without
# this, push sends are a documented no-op (alerts rows still get written,
# status='failed', error='push_provider_not_configured').
FCM_SERVICE_ACCOUNT_JSON=

# Twilio (or a Twilio-compatible provider). Without these, SMS sends are a
# documented no-op the same way (status='failed', error='sms_provider_not_configured').
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Meta WhatsApp Cloud API (developers.facebook.com → your app → WhatsApp
# product). ACCESS_TOKEN + PHONE_NUMBER_ID come from that product's "API
# Setup" page (a temporary token there is enough to test against the 5
# numbers Meta lets you add before Business Verification — see
# docs/alerts.md). TEMPLATE_NAME/TEMPLATE_LANG default to 'accident_alert'
# and 'es' — only set these if you registered the template under different
# values. Without ACCESS_TOKEN/PHONE_NUMBER_ID, WhatsApp sends are a
# documented no-op the same way (status='failed', error='whatsapp_provider_not_configured').
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TEMPLATE_NAME=
META_WHATSAPP_TEMPLATE_LANG=
